// Small synthetic fixture for the floe DRC viewer, not a Calibre run result.
// Matching files: sample.db, sample.svrf.rules.json, sample.db.clusters.
// sample.oas provides a small companion layout for canvas/ruler testing.
// Rebuild viewer metadata: rust/target/release/floe-index svrf sample.svrf
// All dimensions are in um; AREA values are in um^2.
PRECISION 100000

LAYER M1 1
LAYER M2 2
LAYER VIA1 3

M1.SPACE.1 {
    @ 20 edge-pair errors; CD = 0.01001 / 0.01500 / 0.02000 / 0.02345 / 0.03000.
    @ Existing sample.db.clusters groups arbitrary local error numbers.
    EXTERNAL M1 < 0.05000 SPACE
}

M1.WIDTH.MIN {
    @ Local #1: horizontal only, #2: vertical only, #3: both directions.
    @ Rectangle sizes: 0.02000 x 0.10000, 0.10000 x 0.02000, 0.02000 x 0.03000.
    @ Minimum requirement: choose the smaller violating CD; estimated CD.
    INTERNAL M1 < 0.05000
}

M1.WIDTH.MAX {
    @ Local #1: horizontal only, #2: vertical only, #3: both directions.
    @ Rectangle sizes: 0.10000 x 0.02000, 0.02000 x 0.10000, 0.10000 x 0.12000.
    @ Maximum requirement: choose the larger violating CD; estimated CD.
    INTERNAL M1 > 0.08000
}

M1.NOTCH {
    @ Local #1: horizontal only, #2: vertical only, #3: edge gap 0.02345.
    @ The wrapped range and NOTCH option belong to one measurement statement.
    EXTERNAL M1 > 0
        < 0.05000
        NOTCH
}

VIA1.ENCLOSURE {
    @ Local #1: 0.02000 x 0.10000 rectangle; #2: edge gap 0.02500.
    ENCLOSURE VIA1 M1 < 0.05000
}

M1.M2.OVERLAP {
    @ Two-layer INTERNAL is overlap. Local #1: vertical only; #2: edge gap 0.01500.
    INTERNAL M1 M2 < 0.05000
}

M1.EXTENSION {
    @ Extension uses ENCLOSURE too. Local #1: horizontal only; #2: edge gap 0.03000.
    ENCLOSURE M1 M2 < 0.05000
}

M1.AREA {
    @ Local #1: rectangle 0.00400 um^2; #2: triangle 0.00600 um^2; #3: L-shape 0.00360 um^2.
    @ Show polygon area instead of width/height rulers. Deltas: 0.00600 / 0.00400 / 0.00640.
    AREA M1 < 0.01000
}
