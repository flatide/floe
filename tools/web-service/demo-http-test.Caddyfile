# LAN TEST ONLY. Add this site block to the existing Caddy configuration.
# Replace BOTH occurrences of 10.0.0.10 with this server's LAN interface IP;
# replace the client subnet with the approved test network. Do not bind 0.0.0.0.
# public_origin in demo.json must be exactly http://10.0.0.10:8080.
# Caddy listens on 8080; floe2-web --port stays 58080. Never reuse the same port.
http://10.0.0.10:8080 {
	bind 10.0.0.10

	@demo {
		remote_ip 10.0.0.0/24 127.0.0.1 ::1
		path /demo /server/* /server-assets/* /api/v1/demo/samples /api/v1/demo/launches /api/v1/server/sessions/*
	}
	handle @demo {
		request_body {
			max_size 4096
		}
		reverse_proxy 127.0.0.1:58080 {
			import /etc/caddy/floe-demo-proxy.caddy
			header_up -X-Floe-Service-Client
			header_up -X-Floe-Delegation-Key
			header_up -Authorization
			header_up -Forwarded
			transport http {
				versions 1.1
				dial_timeout 3s
			}
		}
	}
	handle {
		respond "Not found" 404
	}
	# No access/debug logging of cookies, CSRF, WS subprotocols or bodies.
	# Do not enable automatic request retries, caching, or an HTTPS redirect.
}
